
@model PizzaStar.Models.Pages.PagedList<PizzaStar.Models.Product>

@{
    Layout = "_PanelLayout.cshtml";
    ViewData["Title"] = "Страви";
}

<div class="breadcrumb-main">
    <div class="breadcrumb-container clearfix">
        <h1 class="page-title">Продукти</h1>
        <ul class="breadcrumb">
            <li><a asp-action="Index" asp-controller="Panel">Головна</a></li>
            <li><a asp-action="Dishes" asp-controller="Panel">Продукти</a></li>
        </ul>
    </div>
</div>

<div class="container mt-4">
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(product.Image))
                    {
                        <img src="@product.Image"
                             class="card-img-top"
                             alt="@product.Name" />
                    }

                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@product.Description</p>
                        <p><strong>Ціна:</strong> @product.Price.ToString("N2")</p>

                        <form asp-controller="Cart"
                              asp-action="Add"
                              method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@product.Id" />

                            <button type="submit" class="btn btn-primary">
                                Додати в кошик
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
