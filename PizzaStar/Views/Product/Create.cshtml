@model PizzaStar.Models.Product

@{
    ViewData["Title"] = "Створити товар";
}

<div class="container mt-4">
    <h1 class="mb-4">Створити товар</h1>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <form asp-controller="Product"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Назва</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Опис</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Ціна</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Weight" class="form-label">Вага</label>
            <input asp-for="Weight" type="number" step="0.01" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Calories" class="form-label">Калорії</label>
            <input asp-for="Calories" type="number" step="0.01" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Brand" class="form-label">Бренд</label>
            <input asp-for="Brand" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Image" class="form-label">URL зображення</label>
            <input asp-for="Image" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">Тип товару</label>
            <select asp-for="Type"
                    asp-items="Html.GetEnumSelectList<PizzaStar.Models.ProductType>()"
                    class="form-select">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">ID категорії</label>
            <input asp-for="CategoryId" type="number" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Створити товар
        </button>

        <a asp-controller="Panel"
           asp-action="Dishes"
           class="btn btn-secondary">
            Назад
        </a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}